# =============================================================
#  TalkNet — production .env template
#  Copy this to `.env` and fill every value before running
#  `docker compose up -d --build`.
# =============================================================

# ---- Public URL where users reach TalkNet ----
# Include scheme + no trailing slash.
# Examples: https://talknet.example.com  |  http://vps-ip
PUBLIC_BASE_URL=https://talknet.example.com

# ---- Proxy ports on the host (rarely changed) ----
HTTP_PORT=80
HTTPS_PORT=443

# ---- Database ----
DB_NAME=talknet

# ---- Auth ----
# Generate a strong random 64-hex string:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---- Platform Owner seed (superadmin) ----
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=CHANGE_ME_strong_password

# ---- LiveKit Cloud creds ----
# Free project at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=CHANGE_ME_livekit_secret

# ---- (Optional) PostgreSQL — only if you enable the postgres service ----
# POSTGRES_USER=talknet
# POSTGRES_PASSWORD=CHANGE_ME_pg_password
# POSTGRES_DB=talknet
